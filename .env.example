# Copy this file to .env and adjust if needed. .env is gitignored - never commit it.
# GitHub Models (retired 2026-07-30) is no longer used. These are only needed if
# your local Ollama server/model differs from the defaults baked into OllamaExtractor
# (http://localhost:11434/v1, model llama3.2:3b).
OLLAMA_ENDPOINT=
OLLAMA_MODEL=
